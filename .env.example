# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every key here is read by backend/app/core/config.py
# (and re-used by the telegram/scheduler containers via docker-compose env_file).
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_habit_tracker
# Use "db" when running under docker-compose, "localhost" when running natively.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Optional: set to override the URL assembled from the parts above.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/smart_habit_tracker

# --- FastAPI ---------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# Shared secret the telegram/scheduler containers present on /internal/* calls.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change-me-internal-key

# --- Authentication --------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-super-secret-jwt-signing-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to false for plain-http local dev if your browser rejects the cookie.
COOKIE_SECURE=true
# lax for local dev (same-origin via the Vite proxy). Use none in production
# when the frontend and API are on different sites; none requires
# COOKIE_SECURE=true and the API refuses to start otherwise.
COOKIE_SAMESITE=lax

# --- Telegram --------------------------------------------------------------
# From @BotFather. The bot needs it, and so does the API: reminders are sent
# from the API's dispatch pass, not from the bot.
TELEGRAM_BOT_TOKEN=
# Without the leading @, e.g. my_time_intel_bot
TELEGRAM_BOT_USERNAME=
# Generate with: openssl rand -hex 32 — validated on every incoming webhook.
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret
# Public HTTPS URL of the telegram container's webhook route. Leave blank
# locally to run the bot in long-polling mode instead.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_LINK_CODE_TTL_MINUTES=10

# --- Service-to-service ----------------------------------------------------
# Where the telegram/scheduler containers reach the backend REST API.
BACKEND_API_URL=http://backend:8000
# Where the bot points a user who hasn't linked their account yet.
WEB_APP_URL=http://localhost:5173
# How often the local scheduler calls POST /internal/dispatch, in seconds.
# Also how late an "on time" lecture warning can be, so keep it small.
# (Production uses the Cloudflare cron Worker in dispatch-cron/ instead.)
DISPATCH_INTERVAL_SECONDS=60

# --- Dispatch (read by the API) -------------------------------------------
# How long the bot stays quiet after a reminder that was ignored, snoozed or
# skipped. Only Done clears it early.
QUIET_MINUTES_AFTER_REMINDER=60
# Where a dispatch pass reaches the API. Leave blank: it calls its own process
# over loopback on API_PORT.
DISPATCH_API_URL=
