# Normalise line endings in the repository.
#
# Without this, a Windows checkout (core.autocrlf=true) gives shell scripts CRLF
# endings, they get COPYed into the Linux images that way, and the kernel reads
# the shebang as `#!/usr/bin/env sh\r` — so the container dies at startup with
# "env: 'sh\r': No such file or directory". CI only builds the images, never
# runs them, so nothing catches it there.
* text=auto

# Anything executed inside a container must be LF, whatever the host does.
*.sh text eol=lf
entrypoint.sh text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Keeps diffs sane for the rest of the toolchain.
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
